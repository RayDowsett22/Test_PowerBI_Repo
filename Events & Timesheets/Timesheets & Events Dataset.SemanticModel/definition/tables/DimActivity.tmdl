	partition DimActivity = m
		mode: import
		queryGroup: Dimensions
		source =
				let
				    Source = Sql.Database(Instances, "JNBDW"),
				    dbo_DimActivity = Source{[Schema="dbo",Item="DimActivity"]}[Data],
				    #"Added Conditional Column" = Table.AddColumn(dbo_DimActivity, "Input Description", each if [ActivityID] = 1088 then "Site Visitor Hours" else [ActivityDescription])
				in
