	column Timesheet-All
		dataType: boolean
		formatString: """TRUE"";""TRUE"";""FALSE"""
		lineageTag: 1e76dda8-657e-4651-8121-b00ef0cd833f
		summarizeBy: none
		sourceColumn: Timesheet-All

		annotation SummarizationSetBy = Automatic

	column ConditionalFormatAll =
			
			IF (
			    DimActivity[Payroll] = TRUE ()
			        && DimActivity[Payroll-All] = TRUE (),
			    "#f29a39",
			    IF (
			        DimActivity[Timesheet] = TRUE ()
			            && DimActivity[Timesheet-All] = TRUE (),
			        "#f29a39",
			        IF (
			            DimActivity[Payroll] = FALSE ()
			                && DimActivity[Payroll-All] = TRUE (),
			            "#0179dd",
			            IF (
			                DimActivity[Timesheet] = FALSE ()
			                    && DimActivity[Timesheet-All] = TRUE (),
			                "#0179dd",
			                "#f29a39"
			            )
			        )
			    )
			)
		displayFolder: 2. Calculated Columns
		lineageTag: 3446ff3b-f650-46de-ad30-67560ed0e7d6
		summarizeBy: none

		annotation SummarizationSetBy = Automatic

	column ConditionalFormatPayroll =
			
			IF (
			    DimActivity[Payroll] = TRUE ()
			        && DimActivity[Payroll-All] = TRUE (),
			    "#f29a39",
			    IF (
			        DimActivity[Payroll] = FALSE ()
			            && DimActivity[Payroll-All] = TRUE (),
			        "#0179dd",
			        "#000000"
			    )
			)
		displayFolder: 2. Calculated Columns
		lineageTag: c6497f43-2435-41c2-b7a3-62589ac30c24
		summarizeBy: none

		annotation SummarizationSetBy = Automatic

	column ConditionalFormatTimesheet =
			
			IF (
			    DimActivity[Timesheet] = TRUE ()
			        && DimActivity[Timesheet-All] = TRUE (),
			    "#f29a39",
			    IF (
			        DimActivity[Timesheet] = FALSE ()
			            && DimActivity[Timesheet-All] = TRUE (),
			        "#0179dd",
			        "#000000"
			    )
			)
		displayFolder: 2. Calculated Columns
		lineageTag: 1b74d7dd-9807-445e-8c3d-f1dfcbdc73b5
		summarizeBy: none

		annotation SummarizationSetBy = Automatic

