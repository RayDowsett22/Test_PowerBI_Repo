	measure 'Number of Events + 0' = [Number of Events]+0
		formatString: #,0
		displayFolder: 1. Measures
		lineageTag: b4aafbdb-7d1d-4581-a90f-4eba1f5d2f07

	measure '% Categorisation' = ```
			
			
			/* DOCUMENTATION *
			Get the % of events of then Categorisation
			
			Get the % the member contributes to the group total, but return blanks when at group level.
			
			The SWITCH uses ISFILTERED to determin which report is being run.
			If the HASONEVALUE has 1 member then it is at member level, otherwise it is at group level.
			The ALLSELETED overrides the row and columns context but retains all other slicer filters.
			*/
			VAR grouptotal = 
			SWITCH(TRUE(),
			
			-- L3 by L2
			AND(ISFILTERED(DimLevel3Categorisation[Level 3 Categorisation]), ISFILTERED(DimLevel3Categorisation[Level 3 Categorisation])),
			
				IF(HASONEVALUE(DimLevel3Categorisation[Level 3 Categorisation]),
				CALCULATE([Number of Events],ALLSELECTED(DimLevel3Categorisation[Level 3 Categorisation])),
				BLANK()),
			
			-- L2 by L1
			AND(ISFILTERED(DimLevel2Categorisation[Level 2 Categorisation]), ISFILTERED(DimLevel2Categorisation[Level 2 Categorisation])),
			    
				IF(HASONEVALUE(DimLevel2Categorisation[Level 2 Categorisation]),
				CALCULATE([Number of Events],ALLSELECTED(DimLevel2Categorisation[Level 2 Categorisation])),
				BLANK()),
			    
			-- L1 by Form
			AND(ISFILTERED(DimLevel1Categorisation[Level 1 Categorisation]), ISFILTERED(DimEventType[EventTypeDescription_new])),
			
				IF(HASONEVALUE(DimLevel1Categorisation[Level 1 Categorisation]),
				CALCULATE([Number of Events],ALLSELECTED(DimLevel1Categorisation[Level 1 Categorisation])),
				BLANK()),
			
			-- L2 
			ISFILTERED(DimLevel2Categorisation[Level 2 Categorisation]), 
			    
				IF(HASONEVALUE(DimLevel2Categorisation[Level 2 Categorisation]),
				CALCULATE([Number of Events],ALLSELECTED(DimLevel2Categorisation[Level 2 Categorisation])),
				BLANK()),
			    
			-- by Form
			 ISFILTERED(DimEventType[EventTypeDescription_new]),
			
				IF(HASONEVALUE(DimEventType[EventTypeDescription_new]),
				CALCULATE([Number of Events],ALLSELECTED(DimEventType[EventTypeDescription_new])),
				BLANK()),
			
			BLANK()
			)
			
			RETURN
			DIVIDE([Number of Events], grouptotal, BLANK())
			```
		formatString: 0.0%;-0.0%;0.0%
		displayFolder: 1. Measures
		lineageTag: 19d8d9b3-6fb6-4fef-b323-5860dd582fa8

