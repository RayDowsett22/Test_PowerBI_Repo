	measure 'Title for events per 100K hours by person graph' = ```
			
			VAR designee = 
			SWITCH(TRUE(),
			    NOT ISFILTERED('POS - Unpivot'[Role]), BLANK(),
			    HASONEVALUE('POS - Unpivot'[Role]), SELECTEDVALUE('POS - Unpivot'[Role]),
			    BLANK()
			)
			
			VAR person = 
			SWITCH(TRUE(),
			    NOT ISFILTERED('POS - Unpivot'[Value]), "no person has been selected",
			    HASONEVALUE('POS - Unpivot'[Value]), SELECTEDVALUE('POS - Unpivot'[Value]),
			    "multiple people have been selected"
			)
			RETURN
			"Events per 100K hrs Company vs Person"
			& UNICHAR(10) &
			"(" & designee & " - " & person & ")"
			```
		displayFolder: 1. Measures
		lineageTag: 4b2cee8d-2e73-4140-912e-3b96b7d4f830

	measure 'Title for events per 100K hours by project graph' = ```
			
