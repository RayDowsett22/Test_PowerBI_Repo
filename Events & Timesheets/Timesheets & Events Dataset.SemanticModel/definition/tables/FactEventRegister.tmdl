	partition FactEventRegister = m
		mode: import
		queryGroup: Facts
		source =
				let
				    Source = Sql.Database(Instances, "JNBDW", [Query="-- Retrieve event register details for events within the reporting period#(lf)SELECT ER.[EventID]#(lf)      ,ER.[EventTypeID]#(lf)      ,ER.[FormTypeID]#(lf)      ,ER.[EventStatusID]#(lf)      ,ER.[Description]#(lf)      ,ER.[DOC_GUID]#(lf)      ,ER.[DOC_REF]#(lf)      ,ER.[ReportedByEntityID]#(lf)      ,ER.[OriginatorEntityID]#(lf)      ,ER.[ProjectID]#(lf)      ,ER.[Level1CatID]#(lf)      ,ER.[Level2CatID]#(lf)      ,ER.[Level3CatID]#(lf)      ,ER.[Datekey]#(lf)      ,ER.[VersionNumber]#(lf)      ,ER.[ParentDocGUID]#(lf)      ,ER.[ParentDocRef]#(lf)      ,ER.[SourceID]#(lf)      ,ER.[ReviewType]#(lf)      ,ER.[ReportedByCategory]#(lf)      ,ER.[InsertAuditID]#(lf)      ,ER.[UpdateAuditID]#(lf)      ,ER.[LogDeleted]#(lf)      ,ER.[Form_id]#(lf)      ,ER.[Level4CatID]#(lf)#(lf)  -- Join to date and event type dimensions for filtering#(lf)  FROM [JNBDW].[dbo].[FactEventRegister] ER INNER JOIN#(lf)               [JNBDW].[dbo].[DimDate] D ON D.[DateID] = ER.[Datekey] INNER JOIN#(lf)               [JNBDW].[dbo].[DimEventType] ET ON ET.[EventTypeID] = ER.[EventTypeID]#(lf)#(lf) -- Include non-deleted events, excluding QES New Starter, from the current and previous 36 months#(lf) WHERE (ER.[LogDeleted] = 0 OR ER.[LogDeleted] IS NULL) AND ET.[EventTypeDescription] <> 'QES New Starter' AND D.[MonthOffset] BETWEEN -36 AND 0"])
				in
				    Source

	annotation PBI_NavigationStepName = Navigation

	annotation PBI_ResultType = Table

