table FactEventActionResponseCarbonSummary
	lineageTag: 0324c8a5-5c7a-40dc-a13d-764ed60718d8

	measure 'Exact CO2 Added' = ```
			
			CALCULATE(
			    SUM(FactEventActionResponseCarbonSummary[ExactCO2]),
			    FILTER(
			        FactEventActionResponseCarbonSummary,
			        FactEventActionResponseCarbonSummary[CO2Factor] =1
			    )
			)
			
			```
		displayFolder: 1. Measures
		lineageTag: 26101fa2-f156-437b-82ac-542550c8a95a

		annotation PBI_FormatHint = {"isGeneralNumber":true}

	measure 'Exact CO2 Impact' =
			
			[Exact CO2 Added]-[Exact CO2 Saved]
		displayFolder: 1. Measures
		lineageTag: e0b41ba7-fc8d-419f-9b97-48cead66448e

	measure 'Exact CO2 Saved' =
			
			CALCULATE(
			    SUM(FactEventActionResponseCarbonSummary[ExactCO2]),
			    FILTER(
			        FactEventActionResponseCarbonSummary,
			        FactEventActionResponseCarbonSummary[CO2Factor] =-1
			    )
			)
		displayFolder: 1. Measures
		lineageTag: 6787efb2-ee9e-43f2-afa6-e9e6adad9774

		annotation PBI_FormatHint = {"isGeneralNumber":true}

	measure '>10 Tonnes CO2e Added' =
			//>10 tonnes CO2
			        CALCULATE(SUM(FactEventActionResponseCarbonSummary[CO2_10]), FILTER(FactEventActionResponseCarbonSummary,FactEventActionResponseCarbonSummary[CO2Factor]>0))
		formatString: 0
		displayFolder: 1. Measures
		lineageTag: aeefb2d5-cd59-49a8-87a1-98aa0596edcf

	measure '>10 Tonnes CO2e Saved' =
			//>10 tonnes CO2
			        CALCULATE(SUM(FactEventActionResponseCarbonSummary[CO2_10]), FactEventActionResponseCarbonSummary[CO2Factor]<0)
		formatString: 0
		displayFolder: 1. Measures
		lineageTag: 18e3f4d6-8060-405c-b3e4-a95107121d76

	measure '0-1 Tonnes CO2e Added' =
			//0-1 tonnes CO2 saved
			        CALCULATE(SUM(FactEventActionResponseCarbonSummary[CO2_0_1]), FactEventActionResponseCarbonSummary[CO2Factor]>0)
		formatString: 0
		displayFolder: 1. Measures
		lineageTag: 44873e99-d1b6-4b76-8148-b55679de5aa0

	measure '0-1 Tonnes CO2e Saved' =
			//0-1 tonnes CO2 added
			        CALCULATE(SUM(FactEventActionResponseCarbonSummary[CO2_0_1]), FactEventActionResponseCarbonSummary[CO2Factor]<0)
		formatString: 0
		displayFolder: 1. Measures
		lineageTag: ccf88073-9e42-4589-b8d5-983f90c761c6

	measure '1-10 Tonnes CO2e Added' =
			//1-10 tonnes CO2
			            CALCULATE(SUM(FactEventActionResponseCarbonSummary[CO2_1_10]), FactEventActionResponseCarbonSummary[CO2Factor]>0)
		formatString: 0
		displayFolder: 1. Measures
		lineageTag: f634fa15-7cd2-4cc4-91a3-784383955a6f

	measure '1-10 Tonnes CO2e Saved' =
			//1-10 tonnes CO2
			            CALCULATE(SUM(FactEventActionResponseCarbonSummary[CO2_1_10]), FactEventActionResponseCarbonSummary[CO2Factor]<0)
		formatString: 0
		displayFolder: 1. Measures
		lineageTag: b53ad438-075b-4167-a655-73caf38c1adc

	measure CO2Added = ```
			
			            [0-1 Tonnes CO2e Added] +
			            [1-10 Tonnes CO2e Added] +
			            [>10 Tonnes CO2e Added]
			```
		formatString: 0
		displayFolder: 1. Measures
		lineageTag: b274d5f3-3867-4504-81f7-879d6536a7f4

	measure CO2Saved = ```
			
			        [0-1 Tonnes CO2e Saved] +
			        [1-10 Tonnes CO2e Saved] +
			        [>10 Tonnes CO2e Saved]
			```
		formatString: 0
		displayFolder: 1. Measures
		lineageTag: 4cfd9fe7-7f30-4ac9-a972-721a7d507824

