	partition FactEventActionResponseCarbonSummary = m
		mode: import
		queryGroup: Facts
		source =
				let
				    Source = Sql.Database(Instances, "JNBDW", [Query="-- Retrieve CO2 impact information for each event#(lf)SELECT ER.[EventID]#(lf)#(lf)      -- Flag events where a CO2 tonnage response has been provided#(lf)      ,SUM(CASE WHEN TC.[EventID] IS NOT NULL THEN 1 ELSE 0 END) AS [CO2Event]#(lf)#(lf)      -- Identify whether carbon was added or saved#(lf)      ,CASE WHEN IY.[Answer] = 'Carbon Added' THEN 1#(lf)                   WHEN IY.[Answer] = 'Carbon Saved' THEN -1#(lf)                   ELSE 0 END [CO2Factor]#(lf)      ,CASE WHEN IY.[Answer] = 'Carbon Added' THEN 'Added'#(lf)                   WHEN IY.[Answer] = 'Carbon Saved' THEN 'Saved'#(lf)                   ELSE 'xxx' END [AddedSaved]#(lf)#(lf)        -- Categorise the reported CO2 tonnage into ranges#(lf)        ,SUM(CASE WHEN TC.[Answer] = '0-1 Tonnes of CO2e' THEN 1 ELSE 0 END) [CO2_0_1]#(lf)        ,SUM(CASE WHEN TC.[Answer] = '1-10 Tonnes of CO2e' THEN 1 ELSE 0 END) [CO2_1_10]#(lf)        ,SUM(CASE WHEN TC.[Answer] = '>10 Tonnes of CO2e' THEN 1 ELSE 0 END) [CO2_10]#(lf)#(lf)        -- Capture the exact CO2 tonnage where provided#(lf)        ,SUM(CASE WHEN ETC.[EventID] IS NOT NULL THEN CAST(ETC.[Answer] AS DECIMAL(10, 3)) END) AS [ExactCO2]#(lf)#(lf)FROM [JNBDW].[dbo].[FactEventRegister] ER INNER JOIN#(lf)            [JNBDW].[dbo].[DimDate] D ON D.[DateID] = ER.[Datekey] INNER JOIN#(lf)            [JNBDW].[dbo].[DimEventType] ET ON ET.[EventTypeID] = ER.[EventTypeID] INNER JOIN#(lf)#(lf)            -- Only include events confirmed as having a carbon impact#(lf)            [JNBDW].[dbo].[FactEventActionResponse] CI ON CI.[EventID] = ER.[EventID] AND (CI.[LogDeleted] = 0 OR CI.[LogDeleted] IS NULL) AND (CI.[Question] = 'Carbon Impact' AND CI.[Answer] = 'Yes') LEFT OUTER JOIN#(lf)#(lf)            -- Retrieve whether the carbon impact was added or saved#(lf)            [JNBDW].[dbo].[FactEventActionResponse] IY ON IY.[EventID] = ER.[EventID] AND (IY.[LogDeleted] = 0 OR IY.[LogDeleted] IS NULL) AND IY.[Question] = 'If Yes' LEFT OUTER JOIN#(lf)#(lf)            -- Retrieve the CO2 tonnage range#(lf)            [JNBDW].[dbo].[FactEventActionResponse] TC ON TC.[EventID] = ER.[EventID] AND (TC.[LogDeleted] = 0 OR TC.[LogDeleted] IS NULL) AND TC.[Question] = 'Tonnes CO2' LEFT OUTER JOIN#(lf)#(lf)            -- Retrieve the exact CO2 tonnage where known#(lf)            [JNBDW].[dbo].[FactEventActionResponse] ETC ON ETC.[EventID] = ER.[EventID] AND (ETC.[LogDeleted] = 0 OR ETC.[LogDeleted] IS NULL) AND ETC.[Question] = 'Exact Tonnes CO2e (if known)'#(lf)#(lf)-- Include non-deleted QC&Event records from the current and previous 36 months#(lf)WHERE (ER.[LogDeleted] = 0 OR ER.[LogDeleted] IS NULL) AND ET.[EventTypeDescription] = 'QC&Event' AND D.[MonthOffset] BETWEEN -36 AND 0#(lf)#(lf)-- Return one result per event and carbon added/saved response#(lf)GROUP BY ER.[EventID]#(lf)                  ,IY.[Answer]"]),
				    #"Filtered Rows" = Table.SelectRows(Source, each ([AddedSaved] <> "xxx"))
				in
				    #"Filtered Rows"

	annotation PBI_NavigationStepName = Navigation

	annotation PBI_ResultType = Table

