	partition POS = m
		mode: import
		queryGroup: Dimensions
		source =
				let
				    Source = Sql.Database(Instances, "JNBDW", [Query="-- Retrieve project, framework, client and key project role details#(lf)SELECT PivotTable.[ProjectID]#(lf)      ,[ProjectCode] AS [Project Code]#(lf)      ,[ProjectName] AS [Project Name]#(lf)#(tab)  ,[ProjectFull] AS [Project Full]#(lf)#(tab)  ,[ProjectTypeID]#(lf)#(tab)  ,[FrameworkContractCode] AS [Framework Contract Code]#(lf)#(tab)  ,[FrameworkContractName] AS [Framework Contract Name]#(lf)#(tab)  ,[FrameworkContractFull] AS [Framework Contract Full]#(lf)#(tab)  ,[ClientCode] AS [Client Code]#(lf)#(tab)  ,[ClientName] AS [Client Name]#(lf)#(tab)  ,[Framework_Agreement_ID] AS [Framework Agreement ID]#(lf)#(tab)  ,[Framework_Agreement_Name] AS [Framework Agreement Name]#(lf)#(tab)  ,[Active]#(lf)#(tab)  ,[PostCode] AS [Post Code]#(lf)#(tab)  ,[CompanyName] AS [Company]#(lf)#(tab)  ,[Director] AS [Commercial Director], [Operations Manager], [Contracts Manager], [Commercial Manager], [Quantity Surveyor], [Site Agent], [Design Manager], [Project Leader], [MEP Engineer], [M&E Design Engineer], [Unit]#(lf)FROM(#(lf)SELECT P.[ProjectID]#(lf)      ,P.[ProjectCode]#(lf)      ,P.[ProjectName]#(lf)#(tab)  ,P.[ProjectTypeID]#(lf)#(tab)  ,CONCAT_WS(' - ',P.[ProjectCode],P.[ProjectName]) AS [ProjectFull]#(lf)#(tab)  ,C.[ContractCode] AS [FrameworkContractCode]#(lf)#(tab)  ,C.[ContractName] AS [FrameworkContractName]#(lf)#(tab)  ,CONCAT_WS(' - ',C.[ContractCode],C.[ContractName]) AS [FrameworkContractFull]#(lf)#(tab)  ,Cl.[ClientCode]#(lf)#(tab)  ,Cl.[ClientName]#(lf)#(tab)  ,F.[Framework_Agreement_ID]#(lf)#(tab)  ,F.[Framework_Agreement_Name]#(lf)#(tab)  ,P.[Active]#(lf)      ,R.[Pos_name]#(lf)      ,E.[ShortName]#(lf)#(tab)  ,P.[PostCode]#(lf)#(tab)  ,Co.[CompanyName]#(lf)  FROM [JNBDW].[dbo].[DimProjectEmployeeRole] PER INNER JOIN#(lf)       [JNBDW].[dbo].[DimRole] R ON PER.[RoleID] = R.[RoleID] INNER JOIN#(lf)#(tab)   [JNBDW].[dbo].[DimProject] P ON PER.[ProjectID] = P.[ProjectID] INNER JOIN#(lf)#(tab)   [JNBDW].[dbo].[DimEntity] E ON PER.[CurrentEmployeeID] = E.[EntityID] INNER JOIN#(lf)#(tab)   [JNBDW].[dbo].[DimContract] C ON P.[ContractID] = C.[ContractID] INNER JOIN#(lf)#(tab)   [JNBDW].[dbo].[DimClient] Cl ON C.[ClientID] = Cl.[ClientID] INNER JOIN#(lf)#(tab)   [JNBDW].[dbo].[DimFramework] F ON C.[FrameWorkID] = F.[FrameworkID] INNER JOIN#(lf)#(tab)   [JNBDW].[dbo].[DimCompany] Co ON Co.[CompanyID] = P.[CompanyID]#(lf)  -- Include current, non-deleted project employee roles#(lf)  WHERE PER.[IsCurrent] = 1 AND PER.[Isdeleted] <> 1 AND PER.RoleID IN (35,23,24,33,28,25,34,29,31,32, 47)) AS SourceTable#(lf)#(lf)-- Pivot employee roles into individual columns against each project#(lf)PIVOT#(lf)(MAX([ShortName]) FOR [Pos_name] IN ([Director], [Operations Manager], [Contracts Manager], [Commercial Manager], [Quantity Surveyor], [Site Agent], [Design Manager], [Project Leader], [MEP Engineer], [M&E Design Engineer], [Unit])) AS PivotTable#(lf)#(lf)#(lf)-- Add projects that do not have project employee roles#(lf)UNION ALL#(lf)#(lf)SELECT P.[ProjectID]#(lf)      ,P.[ProjectCode]#(lf)      ,P.[ProjectName]#(lf)#(tab)  ,CONCAT_WS(' - ',P.[ProjectCode],P.[ProjectName]) AS [ProjectFull]#(lf)#(tab)  ,P.[ProjectTypeID]#(lf)#(tab)  ,C.[ContractCode] AS [FrameworkContractCode]#(lf)#(tab)  ,C.[ContractName] AS [FrameworkContractName]#(lf)#(tab)  ,CONCAT_WS(' - ',C.[ContractCode],C.[ContractName]) AS [FrameworkContractFull]#(lf)#(tab)  ,Cl.[ClientCode]#(lf)#(tab)  ,Cl.[ClientName]#(lf)#(tab)  ,F.[Framework_Agreement_ID]#(lf)#(tab)  ,F.[Framework_Agreement_Name]#(lf)#(tab)  ,P.[Active]#(lf)#(tab)  ,P.[PostCode]#(lf)#(tab)  ,Co.[CompanyName]#(lf)#(tab)  ,NULL#(lf)#(tab)  ,NULL#(lf)#(tab)  ,NULL#(lf)#(tab)  ,NULL#(lf)#(tab)  ,NULL#(lf)#(tab)  ,NULL#(lf)#(tab)  ,NULL#(lf)#(tab)  ,NULL#(lf)#(tab)  ,NULL#(lf)#(tab)  ,NULL#(lf)#(tab)  ,NULL#(lf)FROM [JNBDW].[dbo].[DimProject] P INNER JOIN#(lf)#(tab)        [JNBDW].[dbo].[DimContract] C ON P.[ContractID] = C.[ContractID] INNER JOIN#(lf)#(tab)        [JNBDW].[dbo].[DimClient] Cl ON C.[ClientID] = Cl.[ClientID] INNER JOIN#(lf)#(tab)        [JNBDW].[dbo].[DimFramework] F ON C.[FrameWorkID] = F.[FrameworkID] INNER JOIN#(lf)#(tab)        [JNBDW].[dbo].[DimCompany] Co ON Co.[CompanyID] = P.[CompanyID] INNER JOIN#(lf)#(tab)        [JNBDW].[dbo].[DimProjectType] PT ON PT.[ProjectTypeID] = P.[ProjectTypeID] LEFT OUTER JOIN#(lf)#(tab)#(tab)#(tab)[JNBDW].[dbo].[DimProjectEmployeeRole] PER ON PER.[ProjectID] = P.[ProjectID] AND PER.[Isdeleted] <> 1#(lf)WHERE PER.[ProjectID] IS NULL"]),
				    #"Sorted Rows" = Table.Sort(Source,{{"ProjectID", Order.Ascending}}),
				    #"Replaced Value" = Table.ReplaceValue(#"Sorted Rows",null,"Unassigned",Replacer.ReplaceValue,{"Commercial Director", "Operations Manager", "Contracts Manager", "Commercial Manager", "Quantity Surveyor", "Site Agent", "Design Manager", "Project Leader", "MEP Engineer", "M&E Design Engineer", "Unit"}),
				    #"Filtered Rows" = Table.SelectRows(#"Replaced Value", each not Text.Contains([Project Name], "Dummy")),
				    #"Removed Duplicates" = Table.Distinct(#"Filtered Rows"),
				    #"Renamed Columns" = Table.RenameColumns(#"Removed Duplicates",{{"Commercial Director", "Director"}, {"Site Agent", "SiteAgent"}, {"Operations Manager", "OperationsManager"}, {"Commercial Manager", "CommercialManager"}, {"Contracts Manager", "ContractsManager"}, {"Design Manager", "DesignManager"}, {"Quantity Surveyor", "QuantitySurveyor"}, {"Framework Agreement Name", "FrameworkAgreementName"}, {"Framework Contract Name", "FrameworkContract"}, {"Project Name", "Project"}, {"Client Name", "ClientName"}}),
				    #"Replaced Value1" = Table.ReplaceValue(#"Renamed Columns","A","Active",Replacer.ReplaceText,{"Active"}),
				    #"Replaced Value2" = Table.ReplaceValue(#"Replaced Value1","I","Inactive",Replacer.ReplaceText,{"Active"}),
				    #"Added Conditional Column" = Table.AddColumn(#"Replaced Value2", "ExcludeProjects", each if Text.StartsWith([Project Code], "PRA") then 1 else if Text.StartsWith([Project Code], "ZZ") then 1 else 0)
				in
				    #"Added Conditional Column"

	annotation PBI_NavigationStepName = Navigation

	annotation PBI_ResultType = Table

