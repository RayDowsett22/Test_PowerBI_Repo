	measure 'Matching Targets Frequency Rate' = ```
			
			/* DOCUMENTATION *
			Counts the number of targets that are valid for the selection.
			This is then used in another measures to get the target.
			*/
			VAR EventType = SELECTEDVALUE(DimEventType[EventTypeDescription_new],"*")
			VAR HoursType = SELECTEDVALUE(DimEntityType[EntityTypeDescription],"*")
			VAR LevelType = SWITCH(TRUE(),
			    ISFILTERED(DimEntityType[EntityTypeDescription])=TRUE(),"S",
			    ISFILTERED(DimLevel3Categorisation[Level 3 Categorisation])=TRUE(),"3",
			    ISFILTERED(DimLevel2Categorisation[Level 2 Categorisation])=TRUE(),"2",
			    ISFILTERED(DimLevel1Categorisation[Level 1 Categorisation])=TRUE(),"1",
			    ISFILTERED(DimEventType[EventTypeDescription_new])=TRUE(),"F",
			    BLANK()
			)
			VAR Level1 = SELECTEDVALUE(DimLevel1Categorisation[Level 1 Categorisation])
			VAR Level2 = SELECTEDVALUE(DimLevel2Categorisation[Level 2 Categorisation])
			VAR Level3 = SELECTEDVALUE(DimLevel3Categorisation[Level 3 Categorisation])
			VAR startofcontextperiod = MIN('DimDate'[DateValue])
			VAR endofcontextperiod = MAX(DimDate[DateValue])
			VAR TargetRecord =
			 FILTER('FactTargetRate',
			       'FactTargetRate'[Target type]               = "Event per 100K hrs" 
			    && 'FactTargetRate'[Event Type]                IN {EventType,"*"}
			    && 'FactTargetRate'[HoursType]                 IN {HoursType,"*"}
			    && 'FactTargetRate'[Level]                     IN {LevelType,"*"}   
			    && 'FactTargetRate'[Level 1 Categorisation]    IN {Level1, "*"}
			    && 'FactTargetRate'[Level 2 Categorisation]    IN {Level2, "*"}
			    && 'FactTargetRate'[Level 3 Categorisation]    IN {Level3, "*"}
			    &&  startofcontextperiod                       >= 'FactTargetRate'[Start date]
			    &&  endofcontextperiod                         <= 'FactTargetRate'[End date] 
			    )
			
			RETURN
			COUNTROWS(TargetRecord)
			
			```
		formatString: 0
		displayFolder: 1. Measures
		lineageTag: f064303b-0301-411f-8217-9231b73f1aeb

