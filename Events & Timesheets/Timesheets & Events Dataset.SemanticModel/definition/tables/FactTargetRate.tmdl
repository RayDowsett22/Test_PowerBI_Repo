	measure 'Frequency Rate - RAG' = ```
			
			/* DOCUMENTATION *
			Get the RAG status for the context month.
			Note this measure should only be used to compare monthly actuals vs target % and not weekly, quarterely or yearly.
			*/
			VAR actual          = [Frequency Rate]
			VAR redtarget       = [Frequency Rate - Red Target]
			VAR ambertarget     = [Frequency Rate - Amber Target]
			VAR greentarget     =  [Frequency Rate - Green Target]
			RETURN
			SWITCH(TRUE(),
			redtarget  = blank(), blank(),                    -- dont use rags if target is blank
			actual = blank(), "#FF0000",
			actual  > greentarget, "#00B050",
			actual  > ambertarget, "#92D050",
			actual  < redtarget,   "#FF0000",
			"#FFC000"
			)
			
			```
		displayFolder: 1. Measures
		lineageTag: d9d17659-96dd-4876-ac38-fa2fce247775

	measure 'Frequency Rate - RAG (Project)' = ```
			
			/* DOCUMENTATION *
			Get the RAG status for the context month.
			Note this measure should only be used to compare monthly actuals vs target % and not weekly, quarterely or yearly.
			*/
			VAR actual          = [Frequency Rate]
			VAR redtarget       = IF(SELECTEDVALUE(DimEventType[EventTypeDescription_new]) = "QC&E TA", BLANK(),[Frequency Rate - Red Target])
			VAR ambertarget     = [Frequency Rate - Amber Target]
			VAR greentarget     =  [Frequency Rate - Green Target]
			RETURN
			SWITCH(TRUE(),
			redtarget  = blank(), blank(),                    -- dont use rags if target is blank
			actual = blank(), "#FF0000",
			actual  > greentarget, "#00B050",
			actual  > ambertarget, "#92D050",
			actual  < redtarget,   "#FF0000",
			"#FFC000"
			)
			
			```
		displayFolder: 1. Measures
		lineageTag: 4878b91b-61b3-405a-a31e-830d5f20ce46

