table FactTimeSheetHours
	lineageTag: 4de1383e-3ef3-42d1-8331-bc4805c364ed

	measure 'Hours (ALL)' =
			
			/* RD 29/10/2026
			Timesheet and Attendance Hours
			*/
			VAR TimesheetAll =
			    SELECTEDVALUE ( DimActivity[Timesheet-All] )
			VAR PayrollAll =
			    SELECTEDVALUE ( DimActivity[Payroll-All] )
			RETURN
			    SWITCH (
			        TRUE (),
			        TimesheetAll = TRUE (), SUM ( FactTimeSheetHours[OriginalHours] ),
			        PayrollAll = TRUE (), SUM ( FactTimeSheetHours[OriginalHours] )
			    )
		displayFolder: 1. Measures
		lineageTag: 124ae2a3-f58c-4810-9d5e-4d1de0e5d287

		annotation PBI_FormatHint = {"isGeneralNumber":true}

	measure Hours =
			
			/* RD 29/10/2026
			Timesheet and Attendance Hours
			*/
			VAR Timesheet =
			    SELECTEDVALUE ( DimActivity[Timesheet] )
			VAR Payroll =
			    SELECTEDVALUE ( DimActivity[Payroll] )
			RETURN
			    SWITCH (
			        TRUE (),
			        Timesheet = TRUE (), SUM ( FactTimeSheetHours[TimesheetHours] ),
			        Payroll = TRUE (), SUM ( FactTimeSheetHours[PayrollHours])
			    )
		displayFolder: 1. Measures
		lineageTag: e8ebb1fb-28a1-403c-bd31-7a42768f07fc

		annotation PBI_FormatHint = {"isGeneralNumber":true}

	measure 'External Hours' = CALCULATE([Hours],FILTER(DimDesignation,DimDesignation[DesignationDescription]="Undefined"),FILTER(DimEntityType,DimEntityType[ReportedByCategory]<>"Other"))
