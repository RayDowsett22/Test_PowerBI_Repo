	partition FactTimeSheetHours = m
		mode: import
		queryGroup: Facts
		source =
				let
				    Source = Sql.Database(Instances, "JNBDW", [Query="-- Calculate weekly hours for activities subject to the 8.5-hour rule#(lf)WITH NPP AS(#(lf)SELECT [EntityID]#(lf)            ,[WeekEndDate]#(lf)            ,SUM([TimeSheetHours]) AS [Hours]#(lf)            -- Flag where the employee's weekly total is 8.5 hours or less#(lf)            ,CASE WHEN SUM([TimeSheetHours]) <= 8.5 THEN 1 ELSE 0 END AS [8.5Rule]#(lf)FROM (SELECT T.[EntityID]#(lf)                        ,D.[WeekEndDate]#(lf)                        ,T.[TimeSheetHours]#(lf)                        ,T.LogDeleted#(lf)           FROM [JNBDW].[dbo].[FactTimeSheetHours] T INNER JOIN#(lf)                      [JNBDW].[dbo].[DimDate] D ON T.[TimeSheetDateID] = D.[DateID]#(lf)           WHERE (T.[ActivityID] IN (1017, 1018))) NP#(lf)WHERE [LogDeleted] IS NULL OR [LogDeleted] = 0#(lf)GROUP BY [EntityID]#(lf)                 ,[WeekEndDate]),#(lf) #(lf)-- Calculate weekly hours for activities subject to the 46-hour rule#(lf)HR AS(#(lf)SELECT [EntityID]#(lf)            ,[WeekEndDate]#(lf)            ,SUM([TimeSheetHours]) AS [Hours]#(lf)            -- Flag where the employee's weekly total is 46 hours or less#(lf)            ,CASE WHEN SUM([TimeSheetHours]) <= 46 THEN 1 ELSE 0 END AS [46HourRule]#(lf)FROM (SELECT T.[EntityID]#(lf)                        ,D.[WeekEndDate]#(lf)                        ,T.[TimeSheetHours]#(lf)                        ,T.LogDeleted#(lf)            FROM [JNBDW].[dbo].[FactTimeSheetHours] T INNER JOIN#(lf)                       [JNBDW].[dbo].[DimDate] D ON T.[TimeSheetDateID] = D.[DateID]#(lf)            WHERE T.[ActivityID] = 1061) PHR#(lf)WHERE [LogDeleted] IS NULL OR [LogDeleted] = 0#(lf)GROUP BY [EntityID]#(lf)                  ,[WeekEndDate])#(lf) #(lf)-- Retrieve timesheet records with payroll and timesheet rule adjustments#(lf)SELECT T.TimeSheetHoursID#(lf)            ,T.SourceId#(lf)            ,T.LineGUID#(lf)            ,T.HDRDocGUID#(lf)            ,T.EntityID#(lf)            ,T.TimeSheetDateID#(lf)            ,T.ProjectID#(lf)            ,T.TimeSheetHours OriginalHours#(lf)            ,T.TimeSheet46HourRule#(lf)            ,T.ActivityID#(lf)            ,T.InsertAuditID#(lf)            ,T.UpdateAuditID#(lf)            ,T.SectionIDValue#(lf)            ,T.SubType#(lf)            ,T.LogDeleted#(lf)            ,T.BACK_PAY#(lf)            ,T.BACK_PAY_ENTERED_IN_TS_START_DATE#(lf)            ,T.Division#(lf)            ,T.RateToApply#(lf)            ,T.isCorrection#(lf)            ,A.[Timesheet-All]#(lf)            ,A.[Payroll-All]#(lf)            ,A.[Payroll]#(lf)#(lf)            -- Apply the 8.5-hour rule to calculate payroll hours#(lf)            ,ISNULL(NPP.[8.5Rule], 0) AS [8.5Rule]#(lf)            ,CASE WHEN ISNULL(NPP.[8.5Rule], 0) = 1 THEN T.TimeSheetHours#(lf)                  WHEN T.ActivityID IN (1021, 1037) THEN 0#(lf)                  ELSE T.TimeSheetHours END [PayrollHours]#(lf)#(lf)            ,A.[Timesheet]#(lf)#(lf)            -- Apply the 46-hour rule to calculate timesheet hours#(lf)            ,ISNULL(HR.[46HourRule], 0) AS [46HourRule]#(lf)            ,CASE WHEN ISNULL(HR.[46HourRule], 0) = 1 THEN T.TimeSheetHours#(lf)                  WHEN T.ActivityID IN (1070, 1063) THEN 0#(lf)                  ELSE T.TimeSheetHours END [TimesheetHours]#(lf)#(lf)FROM [JNBDW].[dbo].[FactTimeSheetHours] T INNER JOIN#(lf)           [JNBDW].[dbo].[DimDate] D ON T.[TimeSheetDateID] = D.[DateID] INNER JOIN#(lf)           [JNBDW].[dbo].[DimActivity] A ON A.[ActivityID] = T.[ActivityID] LEFT OUTER JOIN#(lf)           NPP ON NPP.[EntityID] = T.[EntityID] AND   NPP.[WeekEndDate] = D.[WeekEndDate] LEFT OUTER JOIN#(lf)           HR ON HR.[EntityID] = T.[EntityID] AND HR.[WeekEndDate] = D.[WeekEndDate]#(lf)#(lf)-- Include non-deleted timesheet records from the current and previous 36 months#(lf)WHERE (T.LogDeleted IS NULL OR T.LogDeleted = 0) AND D.[MonthOffset] BETWEEN -36 AND 0"])
				in
				    Source

	annotation PBI_NavigationStepName = Navigation

	annotation PBI_ResultType = Table

