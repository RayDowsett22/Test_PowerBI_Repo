	measure 'Hours (All Designation)' = CALCULATE([Hours],ALL(DimDesignation[DesignationDescription]))
		displayFolder: 1. Measures
		lineageTag: 54b29c9a-7ece-4cf3-b1d9-2f3e6303af04

		annotation PBI_FormatHint = {"isGeneralNumber":true}

	measure 'Hours - Company' = ```
			
			/* DOCUMENTATION *
			If report is by project full name then get company total for all projcets.
			If report is by Entity name then get company total for all users.
			Note this measure is field name specific and will not work for other fields like projcet code.
			But you can amend it if necessary.
			*/
			SWITCH(TRUE(),
			
			    ISFILTERED(POS[Project Full]) = TRUE(), 
			        CALCULATE(
			        [Hours],
			        ALL(POS)
			        ),
			
			    ISFILTERED(DimReportedBy[ShortName]) = TRUE(), 
			        CALCULATE(
			        [Hours],
			        ALL(DimReportedBy)
			        ),
			
			    ISFILTERED('POS - Unpivot'[Value]) = TRUE(), 
			        CALCULATE(
			        [Hours],
			        ALL('POS - Unpivot')
			        ),
			
			    [Hours]
			)
			```
		displayFolder: 1. Measures
		lineageTag: a8203d44-33ad-4491-b321-e1764a0b7640

		annotation PBI_FormatHint = {"isGeneralNumber":true}

	measure 'Hours (ALL) (All Designation)' = CALCULATE([Hours (ALL)],ALL(DimDesignation[DesignationDescription]))
