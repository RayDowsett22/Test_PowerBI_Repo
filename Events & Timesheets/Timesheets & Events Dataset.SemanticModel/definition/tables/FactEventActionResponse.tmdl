	partition FactEventActionResponse = m
		mode: import
		queryGroup: Facts
		source =
				let
				    Source = Sql.Database(Instances, "JNBDW", [Query="-- Retrieve event action responses and identify carbon-related events and values#(lf)SELECT EAR.[EventActionID]#(lf)      ,EAR.[EventID]#(lf)      ,EAR.[Response_ID]#(lf)      ,EAR.[Question]#(lf)      ,EAR.[Answer]#(lf)      ,EAR.[AnswerAction]#(lf)      ,EAR.[SEQ_NO]#(lf)      ,EAR.[DOC_GUID]#(lf)      ,EAR.[Requires_Action]#(lf)      ,EAR.[CurrentOwner]#(lf)      ,EAR.[DateOpened]#(lf)      ,EAR.[DateOpenedID]#(lf)      ,EAR.[DateClosed]#(lf)      ,EAR.[DateClosedID]#(lf)      ,EAR.[Duration]#(lf)      ,EAR.[Status]#(lf)      ,EAR.[IsActionClosedinSLA]#(lf)      ,EAR.[InsertAuditID]#(lf)      ,EAR.[UpdateAuditID]#(lf)      ,EAR.[LogDeleted]#(lf)      -- Flag and categorise CO2-related responses#(lf)      ,CASE WHEN EAR.[Question] = 'Tonnes CO2' THEN 1#(lf)#(tab)#(tab)#(tab)      ELSE 0 END [CO2Event]#(lf)#(tab)   ,CASE WHEN EAR.[Question] = 'Carbon Impact' AND EAR.[Answer] = 'Yes' THEN 1#(lf)#(tab)#(tab)#(tab)#(tab)   WHEN EAR.[Question] = 'Carbon Impact' AND EAR.[Answer] = 'No' THEN -1#(lf)#(tab)#(tab)#(tab)#(tab)    ELSE 0 END CO2AddedSaved#(lf)#(tab)   ,CASE WHEN EAR.[Answer] = '0-1 Tonnes of CO2e' THEN 1#(lf)#(tab)#(tab)#(tab)       ELSE 0 END [CO2_0_1]#(lf)#(tab)   ,CASE WHEN EAR.[Answer] = '1-10 Tonnes of CO2e' THEN 1#(lf)#(tab)#(tab)#(tab)       ELSE 0 END [CO2_1_10]#(lf)#(tab)   ,CASE WHEN EAR.[Answer] = '>10 Tonnes of CO2e' THEN 1#(lf)#(tab)#(tab)#(tab)       ELSE 0 END [CO2_10]#(lf)  FROM [JNBDW].[dbo].[FactEventActionResponse] EAR INNER JOIN#(lf)              (SELECT ER.[EventID]#(lf)               FROM [JNBDW].[dbo].[FactEventRegister] ER INNER JOIN#(lf)                            [JNBDW].[dbo].[DimDate] D ON D.[DateID] = ER.[Datekey] INNER JOIN#(lf)                            [JNBDW].[dbo].[DimEventType] ET ON ET.[EventTypeID] = ER.[EventTypeID]#(lf)              -- Include non-deleted events from the current and previous 36 months, excluding QES New Starter#(lf)              WHERE (ER.[LogDeleted] = 0 OR ER.[LogDeleted] IS NULL) AND ET.[EventTypeDescription] <> 'QES New Starter' AND D.[MonthOffset] BETWEEN -36 AND 0) E ON E.[EventID] = EAR.[EventID]#(lf)WHERE EAR.[LogDeleted] = 0 OR EAR.[LogDeleted] IS NULL"])
				in
				    Source

	annotation PBI_NavigationStepName = Navigation

	annotation PBI_ResultType = Table

