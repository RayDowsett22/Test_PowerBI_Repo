table FactEventActionResponse
	lineageTag: 679dcd11-f875-4fb9-86fb-ead668beb3c3

	measure 'Number of Event Actions' =
			
			CALCULATE(IF(COUNT(FactEventActionResponse[RESPONSE_ID])=BLANK(), 0, COUNT(FactEventActionResponse[RESPONSE_ID])),
			FILTER(FactEventActionResponse,FactEventActionResponse[REQUIRES_ACTION] ="Y")
			)
		formatString: #,0
		displayFolder: 1. Measures
		lineageTag: 37d7f1d8-d910-4bf4-b106-ff2f6a1a6272

	measure 'Number of Event Actions + 0' = [Number of Event Actions] + 0
		formatString: #,0
		displayFolder: 1. Measures
		lineageTag: 2bad355a-1e94-4024-92f8-67f8f77f4561

	measure 'Number of Site Support Reponses' = DISTINCTCOUNT(FactEventActionResponse[Response_ID])
		formatString: #,0
		displayFolder: 1. Measures
		lineageTag: b7cb6f46-3ca6-42ef-9e60-466adc083580

	measure 'Total Number of Site Support Reponses' = CALCULATE([Number of Site Support Reponses], FILTER(ALL(RAGOrder),RAGOrder[RAG]<>BLANK()))
		formatString: 0
		displayFolder: 1. Measures
		lineageTag: 552ff006-9bfd-4c58-b27d-5ef692248f54

	measure '% of Site Support Reponses' = DIVIDE([Number of Site Support Reponses],[Total Number of Site Support Reponses])
		formatString: 0.0%;-0.0%;0.0%
		displayFolder: 1. Measures
		lineageTag: df84df7d-9e7e-4087-a2a5-21954fab2a1b

	measure 'Number of Actions Closed' = ```
			
			/* 
			Get the number of action responses closed in SLA by the action open date using the inactive relationahip.
			*/
			CALCULATE(
			DISTINCTCOUNT(FactEventActionResponse[Response_ID]),
			USERELATIONSHIP(FactEventActionResponse[DateOpenedID],'DimDate'[DateID]))
			```
		formatString: #,0
		displayFolder: 1. Measures
		lineageTag: 0c5e2b7e-2c89-47fa-9db9-f591b604a917

	measure 'Number of Actions Closed - SLA' = ```
			
			/* 
			Get the number of actions closed in SLA by the action open date using the inactive relationahip.
			*/
			CALCULATE(
			SUM(FactEventActionResponse[IsActionClosedInSLA]),
			USERELATIONSHIP(FactEventActionResponse[DateOpenedID],'DimDate'[DateID]))
			```
		formatString: #,0
		displayFolder: 1. Measures
		lineageTag: 549a8578-82ad-4545-9d33-0ac83c232ba0

